# Load event study data with stock prices
# Use events_with_returns.csv which has price data
df_events = pd.read_csv(DATA_dir / "events_with_returns.csv")

print("📊 Available columns:")
print(df_events.columns.tolist())
print("\nFirst few rows:")
print(df_events.head())

# Filter for TTWO events only
df_ttwo = df_events[df_events['ticker'] == 'TTWO'].copy()
df_ttwo['event_date'] = pd.to_datetime(df_ttwo['event_date'])
df_ttwo = df_ttwo.sort_values('event_date')

print("\n📊 TTWO Events with Stock Impact:")
print(df_ttwo.head(10))

# Check if we have the required columns
required_cols = ['event_date', 'event_type', 'price_before', 'price_after', 'AR_event']
missing_cols = [col for col in required_cols if col not in df_ttwo.columns]

if missing_cols:
    print(f"\n⚠️ Missing columns: {missing_cols}")
    print(f"Available columns: {df_ttwo.columns.tolist()}")
else:
    print(f"\n✅ All required columns found!")